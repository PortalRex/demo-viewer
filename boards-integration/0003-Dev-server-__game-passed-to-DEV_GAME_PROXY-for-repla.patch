From 11cc78335a4d2b74e159b7c997c37ae884c0c230 Mon Sep 17 00:00:00 2001
From: PortalRex <35444194+PortalRex@users.noreply.github.com>
Date: Wed, 28 Oct 2026 23:05:58 -0500
Subject: [PATCH] Dev server: /__game passed to DEV_GAME_PROXY, for replays' 3D
 view without picking the game folder

---
 frontend/README.md      | 3 +++
 frontend/vite.config.ts | 5 +++++
 2 files changed, 8 insertions(+)

diff --git a/frontend/README.md b/frontend/README.md
index e56efab..3240979 100644
--- a/frontend/README.md
+++ b/frontend/README.md
@@ -35,5 +35,8 @@ the boards and demos from this site's API. Build it from the viewer's checkout:
 node tools/build-boards.mjs <path to this repo>   # writes frontend/public/viewer (git-ignored)
 ```
 
+For local testing, `DEV_GAME_PROXY` (e.g. `http://localhost:5174`, the viewer's own dev server, which hands out
+the local Portal 2 install at `/__game/`) lets the replays' 3D view run without picking the game folder.
+
 Without it, none of this shows and `/viewer/` is a 404. nginx gives `/viewer/` its own security headers
 (`viewer-security-headers.conf`: it may be framed by the site only).
diff --git a/frontend/vite.config.ts b/frontend/vite.config.ts
index adb5d18..db70ae5 100644
--- a/frontend/vite.config.ts
+++ b/frontend/vite.config.ts
@@ -29,6 +29,10 @@ const viewerIndex = (): Plugin => ({
 // The dev server passes /api to the Rust web server (DEV_API_PROXY), so the site can use the
 // same-origin /api/v1 base as production and work from other devices without CORS changes.
 const apiProxy = process.env.DEV_API_PROXY ?? 'http://localhost:8080'
+// The demo viewer's 3D view reads the game from /__game/ where a server hands out a local install
+// (the viewer's own dev server does): set DEV_GAME_PROXY to it, and the replays on this machine need
+// no game folder picked. Browsers won't open folders under Program Files, Steam's default library.
+const gameProxy = process.env.DEV_GAME_PROXY
 
 export default defineConfig(({ mode }) => {
   process.env.VITE_VIEWER ??= viewerBuiltIn(mode) ? 'true' : 'false'
@@ -58,6 +62,7 @@ export default defineConfig(({ mode }) => {
         // xfwd passes the browser's host along (X-Forwarded-Host): Steam sign-in compares it with
         // SERVER.PUBLIC_URL.
         '/api': { target: apiProxy, changeOrigin: true, xfwd: true },
+        ...(gameProxy ? { '/__game': { target: gameProxy, changeOrigin: true } } : {}),
       },
     },
   }
-- 
